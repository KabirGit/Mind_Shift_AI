# AI Reflection Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# Only MISTRAL_API_KEY is required. Everything else has working defaults.

# ── Required ──────────────────────────────────────────────────────────
# Free-tier Mistral API key. Get one at: https://console.mistral.ai
# The free tier is sufficient — this app makes one LLM call per journal entry.
MISTRAL_API_KEY=your_mistral_api_key_here

# ── Optional: Storage ─────────────────────────────────────────────────
# SQLITE_PATH=data/journal.db
# VECTOR_STORE_DIR=faiss_store
# DATA_DIR=data
# LATENCY_LOG_PATH=data/latency_log.jsonl

# ── Optional: Model settings ──────────────────────────────────────────
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
# HF_MAX_NEW_TOKENS=220
# HF_TEMPERATURE=0.2
# HF_TIMEOUT_S=30

# ── Optional: Memory & retrieval ─────────────────────────────────────
# STM_SIZE=10
# SESSION_STM_SIZE=8
# RETRIEVAL_SEMANTIC_WEIGHT=0.6
# RETRIEVAL_EMOTION_WEIGHT=0.25
# RETRIEVAL_RECENCY_WEIGHT=0.15
# RETRIEVAL_HALF_LIFE_HOURS=72
# RETRIEVAL_CANDIDATE_POOL=20
# LTM_MAX_ENTRIES=0

# Optional: Dashboard story confidence gates
# DASHBOARD_MIN_INSIGHT_CONFIDENCE=0.5
# DASHBOARD_MIN_MENTION_COUNT=3
# DASHBOARD_MIN_ENTRY_COUNT=5
