# MindShift AI - environment configuration
# Copy this file to .env and fill in your values.

# Required for the default Hugging Face model route.
# Create a fine-grained token with "Make calls to Inference Providers" permission:
# https://huggingface.co/settings/tokens
LLM_BACKEND=huggingface
HF_TOKEN=your_hugging_face_token_here
HF_MODEL=arsoban/ocd-therapist-27b-v0.3
HF_INFERENCE_PROVIDER=featherless-ai

# Optional Hugging Face transport/model settings.
# HF_MAX_NEW_TOKENS=220
# HF_TEMPERATURE=0.2
# HF_CONNECT_TIMEOUT_S=5
# HF_READ_TIMEOUT_S=30
# HF_MAX_ATTEMPTS=2
# HF_RETRY_BACKOFF_S=0.25

# Optional compatibility route: set LLM_BACKEND=mistral and configure these.
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-small
# MISTRAL_MAX_TOKENS=220
# MISTRAL_CONNECT_TIMEOUT_S=5
# MISTRAL_READ_TIMEOUT_S=30

# Optional storage.
# SQLITE_PATH=data/journal.db
# VECTOR_STORE_DIR=faiss_store
# DATA_DIR=data
# LATENCY_LOG_PATH=data/latency_log.jsonl

# Optional local models.
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMOTION_MODEL=SamLowe/roberta-base-go_emotions

# Optional memory and retrieval.
# STM_SIZE=10
# SESSION_STM_SIZE=8
# RETRIEVAL_SEMANTIC_WEIGHT=0.6
# RETRIEVAL_EMOTION_WEIGHT=0.25
# RETRIEVAL_RECENCY_WEIGHT=0.15
# RETRIEVAL_HALF_LIFE_HOURS=72
# RETRIEVAL_CANDIDATE_POOL=20
# LTM_MAX_ENTRIES=0

# Optional dashboard confidence gates.
# DASHBOARD_MIN_INSIGHT_CONFIDENCE=0.5
# DASHBOARD_MIN_MENTION_COUNT=3
# DASHBOARD_MIN_ENTRY_COUNT=5
